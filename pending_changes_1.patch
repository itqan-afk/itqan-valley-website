+@media(max-width:760px){.proof-grid{grid-template-columns:1fr}.dash{margin-top:22px}}
+/* workflow */
+.bridge{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px}
+.bridge span{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:7px 15px;font-size:12.5px;font-weight:800;color:var(--cyan)}
+.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}
+.step{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px}
+.step b{font-size:13px;font-weight:800;color:var(--cyan)}
+.step h4{font-size:18px;color:var(--ink);margin:10px 0 8px}
+.step p{font-size:13px;color:var(--mut);line-height:1.6}
+/* contact */
+.contact{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(24px,4vw,50px);align-items:center}
+.contact-h{font-size:clamp(28px,3.8vw,48px);letter-spacing:-.02em;margin-top:10px;color:#fff}
+.contact-text{color:var(--onNm);margin-top:14px;max-width:52ch;line-height:1.7}
+.contact-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
+.contact-card{background:#ffffff0d;border:1px solid #ffffff1f;border-radius:20px;padding:26px}
+.contact-card .brand-lockup{margin-bottom:14px}
+.contact-card>p{color:var(--onNm);font-size:14px;line-height:1.8;margin-top:4px}
+.pts{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
+.pts span{border:1.5px solid #ffffff30;border-radius:999px;padding:6px 13px;font-size:12.5px;font-weight:700}
+@media(max-width:760px){.contact{grid-template-columns:1fr}}
+/* footer */
+.foot{background:var(--navy);color:var(--onNm);padding:26px 0;border-top:1px solid #ffffff14}
+.foot .wrap{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;font-size:13px}
+@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
+:focus-visible{outline:2px solid var(--ring);outline-offset:3px}
